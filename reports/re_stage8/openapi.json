  "components": {
    "schemas": {
      "CashTiming": {
        "type": "string",
        "enum": [
          "early",
          "middle",
          "late"
        ],
        "title": "CashTiming"
      },
      "CsvCashflowRequest": {
        "properties": {
          "reference_date": {
            "type": "string",
            "format": "date",
            "title": "Reference Date"
          },
          "opening_cash": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Opening Cash"
          },
          "safe_cash_threshold": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Safe Cash Threshold"
          },
          "events_csv": {
            "type": "string",
            "maxLength": 1500000,
            "title": "Events Csv"
          },
          "loans_csv": {
            "type": "string",
            "maxLength": 500000,
            "title": "Loans Csv",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "reference_date",
          "opening_cash",
          "safe_cash_threshold",
          "events_csv"
        ],
        "title": "CsvCashflowRequest"
      },
      "EligibilityRequest": {
        "properties": {
          "profile": {
            "$ref": "#/components/schemas/SessionEligibilityProfile"
          },
          "policy_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 10,
            "title": "Policy Ids"
          },
          "as_of": {
            "type": "string",
            "format": "date",
            "title": "As Of",
            "default": "2026-08-16"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "profile"
        ],
        "title": "EligibilityRequest"
      },
      "ExpenseType": {
        "type": "string",
        "enum": [
          "rent",
          "labor",
          "purchase",
          "tax",
          "utility",
          "social_insurance",
          "vehicle_fuel",
          "equipment",
          "repair",
          "other"
        ],
        "title": "ExpenseType"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "OtherFixedCost": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          },
          "amount": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Amount"
          },
          "payment_day": {
            "type": "integer",
            "maximum": 31.0,
            "minimum": 1.0,
            "title": "Payment Day"
          },
          "expense_type": {
            "$ref": "#/components/schemas/ExpenseType",
            "default": "other"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "amount",
          "payment_day"
        ],
        "title": "OtherFixedCost"
      },
      "PolicyQuestionRequest": {
        "properties": {
          "policy_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Policy Id"
          },
          "policy_version": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Policy Version"
          },
          "question": {
            "type": "string",
            "maxLength": 500,
            "minLength": 2,
            "title": "Question"
          },
          "as_of": {
            "type": "string",
            "format": "date",
            "title": "As Of",
            "default": "2026-08-16"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "policy_id",
          "question"
        ],
        "title": "PolicyQuestionRequest"
      },
      "QuickModeInput": {
        "properties": {
          "reference_date": {
            "type": "string",
            "format": "date",
            "title": "Reference Date"
          },
          "opening_cash": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Opening Cash"
          },
          "safe_cash_threshold": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Safe Cash Threshold"
          },
          "monthly_revenue": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Monthly Revenue"
          },
          "recent_monthly_revenues": {
            "anyOf": [
              {
                "items": {
                  "type": "integer"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Recent Monthly Revenues"
          },
          "revenue_timing": {
            "$ref": "#/components/schemas/RevenueTiming"
          },
          "monthly_rent": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Monthly Rent"
          },
          "monthly_labor_cost": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Monthly Labor Cost"
          },
          "monthly_variable_cost": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Monthly Variable Cost"
          },
          "expense_timing": {
            "$ref": "#/components/schemas/CashTiming"
          },
          "total_loan_balance": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Total Loan Balance"
          },
          "annual_interest_rate_percent": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Annual Interest Rate Percent",
            "default": 0
          },
          "remaining_term_months": {
            "type": "integer",
            "maximum": 360.0,
            "minimum": 1.0,
            "title": "Remaining Term Months",
            "default": 60
          },
          "debt_timing": {
            "$ref": "#/components/schemas/CashTiming"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "reference_date",
          "opening_cash",
          "safe_cash_threshold",
          "revenue_timing",
          "monthly_rent",
          "monthly_labor_cost",
          "monthly_variable_cost",
          "expense_timing",
          "total_loan_balance",
          "debt_timing"
        ],
        "title": "QuickModeInput"
      },
      "RepresentativeAgeBand": {
        "type": "string",
        "enum": [
          "40세 미만",
          "40~49세",
          "50세 이상",
          "모름"
        ],
        "title": "RepresentativeAgeBand"
      },
      "RevenueTiming": {
        "type": "string",
        "enum": [
          "daily",
          "weekly",
          "month_start",
          "month_middle",
          "month_end"
        ],
        "title": "RevenueTiming"
      },
      "SampleCompareRequest": {
        "properties": {
          "area_code": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 30
              },
              {
                "type": "null"
              }
            ],
            "title": "Area Code"
          },
          "industry_code": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 30
              },
              {
                "type": "null"
              }
            ],
            "title": "Industry Code"
          },
          "sample_id": {
            "type": "string",
            "title": "Sample Id",
            "default": "declining_cash_shortage"
          },
          "simple_input": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SimpleCashflowInput"
              },
              {
                "type": "null"
              }
            ]
          },
          "quick_input": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/QuickModeInput"
              },
              {
                "type": "null"
              }
            ]
          },
          "existing_loan_rate_percent": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Existing Loan Rate Percent",
            "default": 12
          },
          "existing_loan_term_months": {
            "type": "integer",
            "maximum": 360.0,
            "minimum": 1.0,
            "title": "Existing Loan Term Months",
            "default": 60
          },
          "direct_shock_13_week_percent": {
            "type": "number",
            "maximum": 1000.0,
            "minimum": -100.0,
            "title": "Direct Shock 13 Week Percent",
            "default": -12
          },
          "direct_shock_6_month_percent": {
            "type": "number",
            "maximum": 1000.0,
            "minimum": -100.0,
            "title": "Direct Shock 6 Month Percent",
            "default": -18
          },
          "safe_cash_override": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 10000000000.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Safe Cash Override"
          },
          "goal": {
            "$ref": "#/components/schemas/UserGoal",
            "default": "최소부채"
          },
          "market_scenario": {
            "type": "string",
            "enum": [
              "downside",
              "central",
              "recovery"
            ],
            "title": "Market Scenario",
            "default": "central"
          },
          "assume_conditional": {
            "type": "boolean",
            "title": "Assume Conditional",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "SampleCompareRequest"
      },
